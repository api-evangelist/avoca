          "name": "List leads (single team)",
          "request": {
            "name": "List leads (single team)",
            "description": {
              "content": "The canonical leads feed for one team: the historical/pull counterpart to the `lead.*` event webhooks, including the raw third-party payload. Keyset cursor-paginated ascending by `(created_at, id)`. Leads from registered test phone numbers are excluded by default (`include_test_numbers=true` opts in). Requires the `read:leads` permission.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "teams",
                ":teamId",
                "leads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<dateTime>",
                  "description": "Inclusive lower bound on `created_at` (>=)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<dateTime>",
                  "description": "Exclusive upper bound on `created_at` (<)"
                },
                {
                  "disabled": false,
                  "key": "medium",
                  "value": "<string>",
                  "description": "Lead-source medium"
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "Lead-source canonical `name` (exact match)"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Lead processing status"
                },
                {
                  "disabled": false,
                  "key": "include_raw",
                  "value": "true",
                  "description": "When `false`, omit the `raw` third-party payload field (default true)"
                },
                {
                  "disabled": false,
                  "key": "include_ignored",
                  "value": "false",
                  "description": "When `true`, include suppressed leads (adds `is_ignored` / `ignored_reason`)"
                },
                {
                  "disabled": false,
                  "key": "include_test_numbers",
                  "value": "false",
                  "description": "When `true`, include leads from the team's registered test phone numbers (default false)"
