        {
          "id": "6f43851f-381c-47ba-8e79-66bc038efa77",
          "name": "List pre-call transfers",
          "request": {
            "name": "List pre-call transfers",
            "description": {
              "content": "List inbound calls that were forwarded to a configured destination *before* the AI agent picked up, based on the team's pre-call transfer rules. These calls have `duration_seconds: 0` because the AI never engaged. Returns a fixed shape and does not honor the team's column allowlist. Requires the `read:calls` permission.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "calls",
                "pre-call-transfers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Results per page (default 100, max 1000)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset (default 0)"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<dateTime>",
                  "description": "Start of date range (ISO 8601; default 7 days ago)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<dateTime>",
                  "description": "End of date range (ISO 8601; default now)"
                },
                {
                  "disabled": false,
